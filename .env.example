# ── Required ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/tradevirtual?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters

# ── Optional (defaults shown) ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Cookie security (set to true in production over HTTPS)
COOKIE_SECURE=false

# Virtual market settings
STARTING_CASH_PAISE=100000000     # 10,00,000 INR = 1 crore paise
REPLAY_SPEED=30                   # 30x (completes one 6.25-hr session in 12.5 min)
LIVE_DELAY_MINUTES=15             # Regulatory delay
STALE_AFTER_MS=30000              # Price considered stale after 30s

# JWT expiry
JWT_EXPIRES_IN=7d

# Data ingest (disable if no Yahoo Finance access)
INGEST_ENABLED=true

# Logging
LOG_LEVEL=info

# Dev CORS origin
CLIENT_ORIGIN=http://localhost:5173
