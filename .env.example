NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false            # true in production
STARTING_CASH_PAISE=100000000  # Rs 10,00,000
REPLAY_SPEED=30                # virtual seconds per wall second in DEMO_REPLAY (1..60)
LIVE_DELAY_MINUTES=15
STALE_AFTER_MS=30000
INGEST_ENABLED=true
SEED_DEMO_USER=false
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173   # dev only, for origin check
